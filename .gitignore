# Python caches, test caches, and build output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Local reference material and profiling workspace
HousenZhu_MEng_Project_Syllabus/
profile_outputs/
tmp/

# Training artifacts stay local. Publish evaluation plots only.
runs_*/
runs/**
!runs/**/
!runs/**/evaluation/**/*.png
!runs/**/evaluation_*/**/*.png

# Model binaries, raw training logs, scheduler output, and locks
*.pt
*.pth
*.ckpt
*.onnx
*.jsonl
*.training.lock
*.out
*.err

# Large archives and reproducible evaluation caches
*.tar.gz
*.tgz
*.zip
*.sqlite
*.sqlite3

# LaTeX build intermediates; finished PDFs remain publishable
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.log
*.out.ps
*.run.xml
*.synctex.gz
*.toc

# Operating-system metadata
.DS_Store
Thumbs.db

# Publish selected finished decks, never their build/render intermediates.
slides/**
